{#- Value constraint for one dtype, matching the RDF the JSON-LD context produces #}
{%- macro constraint(attribute, dtype) -%}
{%- if dtype in object_names -%}
sh:node {{ prefix }}:{{ dtype }}Shape
{%- elif attribute.is_iri -%}
sh:nodeKind sh:IRI
{%- elif dtype in enum_names -%}
{%- for enum in enums if enum.name == dtype -%}
sh:in ( {% for key, value in enum.mappings | dictsort %}{{ json_string(value) }} {% endfor %})
{%- endfor -%}
{%- elif dtype == "number" -%}
sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] )
{%- else -%}
sh:datatype {{ dtype }}
{%- endif -%}
{%- endmacro -%}
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix {{ prefix }}: <{{ repo_ns }}> .
{%- for pfx, value in prefixes %}
@prefix {{ pfx }}: <{{ value }}> .
{%- endfor %}

#########################################################
# Class-scoped prefixes
#########################################################
{%- for object in objects %}
@prefix {{ object.name }}: <{{ repo_ns }}{{ object.name }}/> .
{%- endfor %}
{%- for enum in enums %}
@prefix {{ enum.name }}: <{{ repo_ns }}{{ enum.name }}/> .
{%- endfor %}

#########################################################
# SHACL Shapes
#########################################################

{%- for object in objects %}

{{ prefix }}:{{ object.name }}Shape
    a sh:NodeShape ;
    sh:targetClass {{ prefix }}:{{ object.name }} ;
    {%- for attribute in object.attributes %}
    {#- The IRI the JSON-LD context maps this key to #}
    {%- set iri = attribute.term if attribute.term else object.name ~ ":" ~ attribute.name %}
    sh:property [
        {%- if attribute.multiple %}
        sh:path ( {{ iri }} [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        {%- else %}
        sh:path {{ iri }} ;
        {%- endif %}
        {%- if attribute.dtypes | length > 1 %}
        sh:or ( {% for dtype in attribute.dtypes %}[ {{ constraint(attribute, dtype) }} ] {% endfor %}) ;
        {%- else %}
        {{ constraint(attribute, attribute.dtypes[0]) }} ;
        {%- endif %}
        {%- if attribute.required %}
        sh:minCount 1 ;
        {%- else %}
        sh:minCount 0 ;
        {%- endif %}
        {%- if not attribute.multiple %}
        sh:maxCount 1 ;
        {%- endif %}
        {%- if attribute.docstring %}
        sh:description {{ json_string(attribute.docstring | replace('\n',' ')) }} ;
        {%- endif %}
    ] ;

    {%- endfor %}
.

{%- endfor %}
