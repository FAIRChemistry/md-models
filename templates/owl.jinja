{#
    Non-empty iff any attribute of the object yields a cardinality restriction.
    An optional multivalued attribute constrains nothing.
#}
{%- macro has_restrictions(object) -%}
    {%- for attribute in object.attributes -%}
        {%- if not attribute.multiple or attribute.required -%}x{%- endif -%}
    {%- endfor -%}
{%- endmacro -%}

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix {{ prefix }}: <{{ repo_ns }}> .
{%- for pfx, value in prefixes %}
@prefix {{ pfx }}: <{{ value }}> .
{%- endfor %}

#########################################################
# Class-scoped prefixes
#########################################################
{%- for object in objects %}
@prefix {{ object.name }}: <{{ repo_ns }}{{ object.name }}/> .
{%- endfor %}
{%- for enum in enums %}
@prefix {{ enum.name }}: <{{ repo_ns }}{{ enum.name }}/> .
{%- endfor %}

#########################################################
# Ontology
#########################################################

{{ prefix }}:ontology a owl:Ontology ;
  rdfs:comment "Ontology generated from the {{ prefix }} data model." .

#########################################################
# Classes
#########################################################

{%- for object in objects %}

#########################################################
# Class: {{ object.name }}
#########################################################
{%- if object.docstring %}
{{ wrap(object.docstring, 50, "# ", "# ") }}
#########################################################
{%- endif %}

{{ prefix }}:{{ object.name }} a owl:Class
{%- if object.term %}
  ; rdfs:subClassOf {{ ttl_term(object.term) }}
{%- endif %}
{%- if object.docstring %}
  ; rdfs:comment "{{ ttl_literal(object.docstring) }}"
{%- endif %} .

{#-
    An attribute that is both optional and multivalued carries no cardinality
    constraint, so it contributes no restriction. If *every* attribute is of
    that shape the block below has an empty object list — `rdfs:subClassOf .` —
    which is not valid Turtle, so the whole block is skipped instead.
-#}
{%- if has_restrictions(object) | trim %}
{{ prefix }}:{{ object.name }}
  rdfs:subClassOf
  {%- set first = true -%}
  {%- for attribute in object.attributes %}
    {%- set is_obj = attribute.dtypes[0] in object_names or attribute.dtypes[0] in enum_names -%}
    {%- set emit =
          (attribute.required and not attribute.multiple)
       or (not attribute.required and not attribute.multiple)
       or (attribute.required and attribute.multiple)
    -%}

    {%- if emit %}
      {%- if not first %},{% endif %}
      [
        a owl:Restriction ;
        owl:onProperty {{ object.name }}:{{ attribute.name }}
        {%- if attribute.required and attribute.multiple %}
        {#- a list is one rdf:List node: require a value, but no filler (it would type the list node) #}
        ; owl:minCardinality "1"^^xsd:nonNegativeInteger
        {%- elif is_obj %}
        {%- if attribute.required %}
        ; owl:onClass {{ prefix }}:{{ attribute.dtypes[0] }}
        ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
        {%- else %}
        ; owl:onClass {{ prefix }}:{{ attribute.dtypes[0] }}
        ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
        {%- endif %}
        {%- elif attribute.required %}
        ; owl:cardinality "1"^^xsd:nonNegativeInteger
        {%- else %}
        ; owl:maxCardinality "1"^^xsd:nonNegativeInteger
        {%- endif %}
      ]
      {%- set first = false -%}
    {%- endif %}

  {%- endfor %} .
{%- endif %}

#########################################################
# Properties of {{ object.name }}
#########################################################

{%- for attribute in object.attributes %}

{%- set item_is_obj = attribute.dtypes[0] in object_names or attribute.dtypes[0] in enum_names -%}
{%- set item = (prefix ~ ":" ~ attribute.dtypes[0]) if item_is_obj else attribute.dtypes[0] -%}
{%- set as_link = item_is_obj or attribute.multiple or attribute.is_iri %}

{{ object.name }}:{{ attribute.name }}
  a {% if as_link -%}
    owl:ObjectProperty
  {%- else -%}
    owl:DatatypeProperty
  {%- endif -%} ;
  rdfs:domain {{ prefix }}:{{ object.name }} ;
  {%- if attribute.multiple or attribute.is_iri %}
  {#- arrays are rdf:List nodes and IRIs are links: an rdfs:range of the item type would mistype them #}
  {%- else %}
  rdfs:range {{ item }} ;
  {%- endif %}
  {%- if attribute.term %}
  rdfs:subPropertyOf {{ ttl_term(attribute.term) }} ;
  {%- endif %}
  rdfs:label "{{ object.name }}/{{ attribute.name }}"
  {%- if attribute.multiple %}
  ; rdfs:comment "Ordered list (rdf:List) of {{ item }}.
    {%- if attribute.docstring %} {{ ttl_literal(attribute.docstring) }}{% endif %}"
  {%- elif attribute.docstring %}
  ; rdfs:comment "{{ ttl_literal(attribute.docstring) }}"
  {%- endif %} .

{%- endfor %}
{%- endfor %}

#########################################################
# Enumerations
#########################################################

#########################################################
# Enum metadata properties
#########################################################

{{ prefix }}:enumKey a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:comment "Stable machine-readable enumeration key." .

{{ prefix }}:enumValue a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:comment "Human-readable enumeration value." .

{%- for enum in enums %}

#########################################################
# Enum: {{ enum.name }}
#########################################################

{{ prefix }}:{{ enum.name }}
  a owl:Class ;
  owl:oneOf (
    {%- for key, value in enum.mappings | dictsort %}
    {{ enum.name }}:{{ key }}
    {%- endfor %}
  )
{%- if enum.docstring %}
  ; rdfs:comment "{{ ttl_literal(enum.docstring) }}"
{%- endif %} .

{%- for key, value in enum.mappings | dictsort %}

{{ enum.name }}:{{ key }}
  a owl:NamedIndividual ;
  rdfs:label "{{ ttl_literal(value) }}" ;
  {{ prefix }}:enumKey "{{ key }}" ;
  {{ prefix }}:enumValue "{{ ttl_literal(value) }}" .

{%- endfor %}
{%- endfor %}