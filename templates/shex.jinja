{#
    This macro determines, whether an attribute is required,
    multiple or optional.
#}
{%- macro is_required(attr) -%}
    {%- if attr.required is false and attr.multiple is false -%}
        ?
    {%- elif attr.required is false and attr.multiple is true -%}
        *
    {%- elif attr.required is true and attr.multiple is true -%}
        +
    {%- endif %}
{%- endmacro -%}

{#
    ShExC writes annotations as `// <predicate> <object>` after a triple
    constraint.
#}
{%- macro annotation(attr) -%}
 // rdfs:label "{{ ttl_literal(attr.name) }}"
    {%- if attr.docstring %} // rdfs:comment "{{ ttl_literal(attr.docstring) }}"{%- endif -%}
{%- endmacro %}

{#
    Shape reference for an object or enumeration, otherwise the datatype.
#}
{%- macro value_constraint(attr) -%}
    {%- if attr.dtypes[0] in object_names or attr.dtypes[0] in enum_names -%}
        @{{ prefix }}:{{ attr.dtypes[0] }}
    {%- else -%}
        {{ attr.dtypes[0] }}
    {%- endif -%}
{%- endmacro %}

PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX {{ prefix }}: <{{ repo_ns }}>
{%- for pre, address in prefixes %}
PREFIX {{pre}}: <{{address}}>
{%- endfor %}

#########################################################
# Class-scoped prefixes
#########################################################
{%- for object in objects %}
PREFIX {{ object.name }}: <{{ repo_ns }}{{ object.name }}/>
{%- endfor %}
{%- for enum in enums %}
PREFIX {{ enum.name }}: <{{ repo_ns }}{{ enum.name }}/>
{%- endfor %}

#########################################################
# Shape definitions
#########################################################

{% for object in objects%}
{{ prefix }}:{{object.name}} {
    {%- for attr in object.attributes %}
    {{ object.name }}:{{ attr.name }} {{ value_constraint(attr) }}{{ is_required(attr) }}{{ annotation(attr) }};
    {%- if attr.term %}
    {{ ttl_term(attr.term) }} {{ value_constraint(attr) }}{{ is_required(attr) }}{{ annotation(attr) }};
    {%- endif %}
    {%- endfor %}
}
{%- endfor %}
