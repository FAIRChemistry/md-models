@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix tst: <https://www.github.com/my/repo/> .
@prefix schema: <http://schema.org/> .

#########################################################
# Class-scoped prefixes
#########################################################
@prefix Test: <https://www.github.com/my/repo/Test/> .
@prefix Test2: <https://www.github.com/my/repo/Test2/> .
@prefix Ontology: <https://www.github.com/my/repo/Ontology/> .

#########################################################
# SHACL Shapes
#########################################################

tst:TestShape
    a sh:NodeShape ;
    sh:targetClass tst:Test ;
    sh:property [
        sh:path schema:hello ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:description "The name of the test. This is a unique identifier that helps track individual test cases across the system. It should be descriptive and follow the standard naming conventions." ;
    ] ;
    sh:property [
        sh:path schema:one ;
        sh:or ( [ sh:datatype xsd:double ] [ sh:datatype xsd:string ] ) ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ( schema:something [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:node tst:Test2Shape ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path Test:ontology ;
        sh:in ( "https://www.evidenceontology.org/term/" "https://amigo.geneontology.org/amigo/term/" "http://semanticscience.org/resource/" ) ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
.

tst:Test2Shape
    a sh:NodeShape ;
    sh:targetClass tst:Test2 ;
    sh:property [
        sh:path ( schema:hello [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path schema:one ;
        sh:datatype xsd:double ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
.