PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX tst: <https://www.github.com/my/repo/>
PREFIX schema: <http://schema.org/>

#########################################################
# Class-scoped prefixes
#########################################################
PREFIX Test: <https://www.github.com/my/repo/Test/>
PREFIX Test2: <https://www.github.com/my/repo/Test2/>
PREFIX Ontology: <https://www.github.com/my/repo/Ontology/>

#########################################################
# Shape definitions
#########################################################


tst:Test {
    Test:name xsd:string// rdfs:label "name" // rdfs:comment "The name of the test. This is a unique identifier that helps track individual test cases across the system. It should be descriptive and follow the standard naming conventions.";
    schema:hello xsd:string// rdfs:label "name" // rdfs:comment "The name of the test. This is a unique identifier that helps track individual test cases across the system. It should be descriptive and follow the standard naming conventions.";
    Test:number xsd:decimal?// rdfs:label "number";
    schema:one xsd:decimal?// rdfs:label "number";
    Test:test2 @tst:Test2*// rdfs:label "test2";
    schema:something @tst:Test2*// rdfs:label "test2";
    Test:ontology @tst:Ontology?// rdfs:label "ontology";
}
tst:Test2 {
    Test2:names xsd:string*// rdfs:label "names";
    schema:hello xsd:string*// rdfs:label "names";
    Test2:number xsd:decimal?// rdfs:label "number";
    schema:one xsd:decimal?// rdfs:label "number";
}